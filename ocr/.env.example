# 复制为 .env 后填写。不要把真实 Key 提交到 Git。
# 也支持直接导出环境变量 SILICONFLOW_API_KEY。
SILICONFLOW_API_KEY=sk-your-key

# 云端模型（必须同时通过运行时免费策略校验）
OCR_PRIMARY_MODEL=deepseek-ai/DeepSeek-OCR
OCR_REVIEW_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
# 复核默认是否开启（UI/API 可显式开启；真实评测未显示 CER 收益，默认关闭）
OCR_REVIEW_ENABLED=false
# 识别模式：text = 纯文字（官方 Free OCR.），markdown = 文档转 Markdown
OCR_PROMPT_MODE=text

# 长图分块（像素）。目标 1200px，1000-1500 范围内优先在空白行切开。
OCR_CHUNK_TARGET_HEIGHT=1200
OCR_CHUNK_MIN_HEIGHT=760
OCR_CHUNK_MAX_HEIGHT=1600
OCR_CHUNK_OVERLAP=120
OCR_CHUNK_MAX_WIDTH=1400
OCR_CHUNK_MAX_PIXELS=1500000

# 上传与资源限制
OCR_MAX_UPLOAD_BYTES=31457280
OCR_MAX_IMAGE_PIXELS=80000000
OCR_MAX_IMAGE_WIDTH=8000
OCR_MAX_IMAGE_HEIGHT=40000
OCR_MAX_FILES_PER_SESSION=12

# 免费额度与并发（应用层保护，不能替代云账户计费保护）
OCR_MAX_REQUESTS_PER_JOB=80
OCR_MAX_REQUESTS_PER_DAY=200
OCR_MAX_CONCURRENT_REQUESTS=2
OCR_REQUEST_MIN_INTERVAL_MS=200
OCR_REQUEST_TIMEOUT_SECONDS=120
OCR_MAX_RETRIES=3
OCR_MAX_OUTPUT_TOKENS=6000

# 免费策略快照：官方定价页无法刷新时允许使用的最大快照年龄（小时）
OCR_POLICY_REFRESH_SECONDS=3600
OCR_POLICY_MAX_SNAPSHOT_AGE_HOURS=24

# 缓存
OCR_CACHE_ENABLED=true
OCR_CACHE_TTL_DAYS=30
OCR_DATA_DIR=./.data

# 本地 PP-OCR 插件（可选，默认关闭）
OCR_LOCAL_OCR_ENABLED=false
OCR_LOCAL_OCR_MODEL=PP-OCRv6

# 质量复核：0 表示只复核可疑分块；>0 表示额外按比例抽样
OCR_REVIEW_SAMPLE_RATE=0.0
OCR_MAX_REVIEWS_PER_JOB=40
